{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/agent-garden/catalog-entry.schema.json",
  "title": "Agent Garden Discovery Catalog",
  "description": "Non-executable catalog identity and implementation provenance. Runtime, policy, evaluation, deployment, and release configuration belong to the later blueprint contract.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "entries"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/entry"
      }
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "display_name",
        "summary",
        "lifecycle",
        "ownership",
        "classification",
        "implementations",
        "assurance"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "display_name": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 10
        },
        "lifecycle": {
          "$ref": "#/$defs/lifecycle"
        },
        "ownership": {
          "$ref": "#/$defs/ownership"
        },
        "classification": {
          "$ref": "#/$defs/classification"
        },
        "implementations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/implementation"
          }
        },
        "assurance": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/assurance"
          }
        }
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "replacement_id"
      ],
      "properties": {
        "status": {
          "enum": [
            "active",
            "deprecated",
            "retired"
          ]
        },
        "replacement_id": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "ownership": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "team",
        "contacts"
      ],
      "properties": {
        "team": {
          "type": "string",
          "minLength": 1
        },
        "contacts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "classification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "tags"
      ],
      "properties": {
        "kind": {
          "enum": [
            "standalone",
            "module"
          ]
        },
        "tags": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          }
        }
      }
    },
    "implementation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "status",
        "language",
        "framework",
        "source",
        "reuse"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "status": {
          "enum": [
            "active",
            "deprecated",
            "retired"
          ]
        },
        "language": {
          "type": "string",
          "minLength": 1
        },
        "framework": {
          "$ref": "#/$defs/framework"
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "reuse": {
          "$ref": "#/$defs/reuse"
        }
      }
    },
    "framework": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "package",
        "version_constraint"
      ],
      "properties": {
        "package": {
          "type": "string",
          "minLength": 1
        },
        "version_constraint": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "revision",
        "path"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "format": "uri"
        },
        "revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "path": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "reuse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "template_ref"
      ],
      "properties": {
        "mode": {
          "enum": [
            "reference",
            "remote-template",
            "import"
          ]
        },
        "template_ref": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "assurance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "implementation_id",
        "ref",
        "digest"
      ],
      "properties": {
        "kind": {
          "enum": [
            "structure",
            "runnability",
            "behavior"
          ]
        },
        "implementation_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "ref": {
          "type": "string",
          "format": "uri"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    }
  }
}
