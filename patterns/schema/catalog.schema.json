{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/adk-agent-engineering-101/catalog.schema.json",
  "title": "Agent Engineering Pattern Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "patterns",
    "relations",
    "decision_boundaries"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "patterns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "manifest"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "manifest": {
            "type": "string",
            "pattern": "^patterns/manifests/[a-z0-9-]+\\.json$"
          }
        }
      }
    },
    "relations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source",
          "type",
          "target",
          "reason"
        ],
        "properties": {
          "source": {
            "$ref": "#/$defs/id"
          },
          "type": {
            "enum": [
              "constrains",
              "depends-on",
              "specializes",
              "verifies"
            ]
          },
          "target": {
            "$ref": "#/$defs/id"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "decision_boundaries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "patterns",
          "tension",
          "resolution",
          "rejected_decision"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "patterns": {
            "type": "array",
            "minItems": 2,
            "items": {
              "$ref": "#/$defs/id"
            }
          },
          "tension": {
            "type": "string",
            "minLength": 1
          },
          "resolution": {
            "type": "string",
            "minLength": 1
          },
          "rejected_decision": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    }
  }
}
